{
  "name": "innovos",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "format:frontend": "prettier --write \"frontend/src/**/*.{ts,tsx,json,css}\"",
    "lint:frontend": "eslint frontend/src/",
    "typecheck": "cd frontend && npx tsc --noEmit"
  },
  "lint-staged": {
    "frontend/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "frontend/src/**/*.{json,css,md}": [
      "prettier --write"
    ],
    "*.{yaml,yml,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7"
  }
}
