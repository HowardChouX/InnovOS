# InnovOS 环境变量配置示例
# 复制为 .env 并填入实际值
#
# 管理员每次登录从环境变量实时校验，不存储在数据库中。
# JWT 密钥签名 Token，生产环境必须设置。

# === 必填（Docker 部署需要） ===

# JWT 签名密钥（用于登录 Token 签名）
# 生成: python3 -c "import secrets; print(secrets.token_hex(32))"
INNOVOS_JWT_SECRET=

# 管理员登录名
INNOVOS_ADMIN_USER=youradmin

# 管理员登录密码（至少 8 位，大小写字母 + 数字 + 特殊字符）
INNOVOS_ADMIN_PASSWORD=

# 数据库密码（PostgreSQL + MinIO 共用）
POSTGRES_PASSWORD=changethis
MINIO_ROOT_USER=innovos
MINIO_ROOT_PASSWORD=changethis

# === AI 供应商密钥（选填，不配则 AI 分析功能不可用） ===
# 格式: AI_{供应商ID}_API_KEY
# AI_SILICON_API_KEY=
# AI_DEEPSEEK_API_KEY=

# === 运行环境 ===
# ENV=development | production
# production 启用 JSON 结构化日志
ENV=development
