# InnovOS 环境变量模板
# 部署前复制为 .env 并填入真实值
# cp .env.example .env

# ── JWT 签名密钥（必填，生产必须设置强随机值） ──────────
# 生成: python3 -c "import secrets; print(secrets.token_hex(32))"
INNOVOS_JWT_SECRET=your-jwt-secret-here

# ── 管理员账号 ──────────────────────────────────────────
INNOVOS_ADMIN_USER=admin@innovos.com
INNOVOS_ADMIN_PASSWORD=your-admin-password-here

# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_PASSWORD=your-db-password-here
# 本地开发 `make dev` 默认走 Unix socket `/tmp`(见 README "PostgreSQL socket path")。
# 生产/容器请改回 host=postgres 或自定义 host。
DATABASE_URL=postgresql+psycopg2://innovos:${POSTGRES_PASSWORD}@localhost:5432/innovos?host=/tmp

# ── MinIO 对象存储 ──────────────────────────────────────
MINIO_ROOT_USER=innovos
MINIO_ROOT_PASSWORD=your-minio-password-here
S3_BUCKET=innovos-files
S3_REGION=us-east-1

# ── 主加密密钥(必填,用于加密数据库中存储的供应商 API Key) ────
# 生成: python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# 必须 base64url 编码 32 字节;启动时校验失败则 fail-fast。
# 生产环境必须通过 Docker Secret / Kubernetes Secret / Vault 注入,不要写入 git。
INNOVOS_ENCRYPT_KEY=

# ── AI 供应商配置 ────────────────────────────────────
# 已废弃:AI 供应商 API Key 不再通过环境变量配置。
# 所有 Provider / Key 由管理员登录后,在 /admin/model-services 页面
# 录入数据库,系统使用 AES-256-GCM 加密存储(api_keys 表)。
# 以下历史环境变量仅为迁移期参考,运行时不读取:
# AI_SILICON_API_KEY=
# AI_SILICON_API_HOST=https://api.siliconflow.cn
# AI_DEEPSEEK_API_KEY=
# AI_DEEPSEEK_API_HOST=https://api.deepseek.com

# ── Redis（可选，不配则用 fakeredis 内存模拟） ─────────
# REDIS_URL=redis://localhost:6379/0

# ── CORS 允许来源(production 模式必填) ─────────────────
# 多个用逗号分隔或 JSON 数组格式
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175"]

# ── 运行环境 ────────────────────────────────────────────
ENV=development

# ── Email OTP 验证 ──────────────────────────────────────
# SMTP（开发用 Mailpit：docker compose --profile mail up mailpit）
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@innovos.local
SMTP_TLS=false

# OTP 配置
INNOVOS_OTP_PEPPER=          # 生产必填；开发留空将生成随机值（仅 dev）
EMAIL_OTP_SOFT_FAIL=true     # dev 默认软失败；生产必须 false
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
