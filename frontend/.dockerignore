# 前端 .dockerignore
# 排除不需要复制到镜像中的文件

# 依赖
node_modules/
npm-debug.log*

# 构建产物
dist/
build/

# 测试
tests/
__tests__/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
coverage/
.nyc_output/

# IDE
.vscode/
.idea/

# 日志
*.log

# Git
.git
.gitignore

# 文档
*.md
LICENSE

# Docker
Dockerfile
docker-compose*.yml
.dockerignore

# 环境配置
.env
.env.*

# 开发配置
.eslintrc*
.prettierrc*
# tsconfig.json - 必须保留，构建需要
# vite.config.ts - 必须保留，构建需要
# tailwind.config.* - 必须保留，构建需要
# postcss.config.* - 必须保留，构建需要
